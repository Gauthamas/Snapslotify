<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No network in any build: ML Kit's telemetry dependency (datatransport) declares INTERNET; strip it. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- No photo permission: images come from the system photo picker, the camera or the share sheet. -->

    <!-- The app's own camera (burst, sharpest frame). Without it, or refused, the system camera is used. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The screens are portrait-only, which makes Android infer screen.portrait as required and Play hides the app from
         tablets, desktops and XR. Not required: a landscape-only device still runs the portrait screens (letterboxed). -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!-- Report a problem opens the user's email app (no network in the app): email apps must be visible on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- Add all asks once which calendar app opens the events when more than one can -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Snapslotify">

        <!-- Home: latest screenshots -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The app's own camera: a short burst, the sharpest frame goes to the review -->
        <activity
            android:name=".camera.CameraActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/camera_title" />

        <!-- Review: share sheet target, picker and camera -->
        <activity
            android:name=".review.ReviewActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/review_title">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- some galleries share even one image as a list; the first image is reviewed -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Report a problem: the user picks what went wrong and reviews the email in their own email app -->
        <activity
            android:name=".report.ReportProblemActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/report_title" />

        <!-- About: version and the taps-saved totals kept on the phone -->
        <activity
            android:name=".stats.AboutActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/about_title" />

        <!-- After Add: the taps the page's added events saved -->
        <activity
            android:name=".stats.AddedActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- Shares the metrics log (and, in debug builds, saved test cases) as an explicit user action -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
